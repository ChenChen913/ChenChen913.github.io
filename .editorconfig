# 通用编辑器风格约定，详见 https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# 二进制文件：不做行尾/末尾换行处理，防止编辑器改写损坏
[*.{png,jpg,jpeg,gif,ico,webp,woff,woff2,ttf,eot,otf,zip,tar,gz,pdf,mp4}]
insert_final_newline = false
trim_trailing_whitespace = false
end_of_line = unset

# Makefile 配方必须以 TAB 缩进
[Makefile]
indent_style = tab

# Windows 批处理脚本需要 CRLF 行尾
[*.{bat,cmd}]
end_of_line = crlf

# Markdown / 补丁文件的行尾空白有语义，不能裁剪
[*.{md,diff,patch}]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
