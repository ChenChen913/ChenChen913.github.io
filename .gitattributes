# 强制所有文本文件使用 LF 行尾符，与 .editorconfig 的 end_of_line = lf 一致
* text=auto eol=lf

# 二进制文件显式声明，防止 text=auto 启发式误判后做行尾转换损坏文件
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.exe binary
*.dll binary
*.so binary
*.jar binary
*.ps binary
*.eps binary
*.rtf binary

# Windows 批处理脚本依赖 CRLF 行尾
*.bat text eol=crlf
*.cmd text eol=crlf

# 其他依赖 CRLF 的 Windows 文本格式（与 .editorconfig 保持同步）
*.reg text eol=crlf
*.rc text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
